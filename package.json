{
  "name": "zortex",
  "productName": "Zortex",
  "version": "0.1.0",
  "description": "Parametrik snippet destekli, bölünebilir, platformlar arası terminal",
  "main": "out/main/index.js",
  "author": "Atif Imal",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "test:e2e": "npm run build && playwright test",
    "icon": "electron scripts/make-icon.cjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@withfig/autocomplete": "^2.692.3",
    "@withfig/autocomplete-types": "^1.31.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
